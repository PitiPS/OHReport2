    function initArchOdontogram() {
      [...upperPermArch, ...lowerPermArch].forEach(t => { teethState[t.id] = ['18','28','38','48'].includes(t.id) ? 'unerupted' : 'normal'; });
      [...upperPrimaryArch, ...lowerPrimaryArch].forEach(t => { teethState[t.id] = 'unerupted'; });
      renderDualArch('svg_arch_upper', upperPermArch, upperPrimaryArch, true, 'upper');
