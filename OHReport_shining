    function renderSavedArch(svgId, permList, primaryList, stateToRender, type) {
      const svg = document.getElementById(svgId);
      svg.innerHTML = '';
      const guideOuter = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      guideOuter.setAttribute('d', type === 'upper' ? 'M 26 215 C 35 30, 305 30, 314 215' : 'M 26 35 C 35 220, 305 220, 314 35');
