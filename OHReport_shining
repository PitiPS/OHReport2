        let imgSrc = '';
        const imgEl = row.querySelector('.finding-img');
        const fileInput = row.querySelector('.finding-file');
        if (imgEl && imgEl.getAttribute('data-base64')) imgSrc = imgEl.getAttribute('data-base64');
        else if (fileInput && fileInput.getAttribute('data-base64')) imgSrc = fileInput.getAttribute('data-base64');
        findings.push({ desc, imgSrc });
      });

      const compositeImg = document.getElementById('preview_composite').src;
      const savedTeethState = { ...teethState };

      let riskCaries = 0, initial = 0, cavity = 0;
      Object.values(savedTeethState).forEach(st => {
        if(st==='risk') riskCaries++;
        if(st==='initial') initial++;
        if(st==='cavity') cavity++;
      });
      const totalBad = riskCaries + initial + cavity;
      const sealantNum = chk_sealant ? parseInt(num_sealant || 1) : 0;
      const fillingNum = chk_filling ? parseInt(num_filling || 1) : 0;

      const record = {
          title, name, age, grade, school, date, gum, dentist, advice,
          chk_plaque, chk_fluoride, chk_scaling, chk_filling, num_filling,
          chk_sealant, num_sealant, chk_ext, num_ext, treatment_extra,
          compositeImg, findings, savedTeethState,
          totalBad, fillingNum, sealantNum
      };

      processedRecords.push(record);
      updateDashboard();
      alert(`บันทึกข้อมูลของ ${name} ลงแดชบอร์ดสรุปผลเรียบร้อยแล้ว`);
      switchTab('tab-dashboard');
    }

    function updateDashboard() {
      const tStudent = document.getElementById('student_records_table');
      tStudent.innerHTML = '';
      if(processedRecords.length === 0) {
        tStudent.innerHTML = '<tr><td colspan="6" class="p-4 text-center text-slate-400">ยังไม่มีบันทึกข้อมูล</td></tr>';
      } else {
        processedRecords.forEach((rec, idx) => {
          tStudent.innerHTML += `
            <tr class="border-b border-slate-200 hover:bg-slate-50">
              <td class="p-3">${rec.name}</td>
              <td class="p-3">${rec.grade}</td>
              <td class="p-3">${rec.school}</td>
              <td class="p-3 text-center text-rose-600 font-bold">${rec.totalBad}</td>
              <td class="p-3 text-center"><span class="px-2 py-1 bg-emerald-100 text-emerald-800 rounded text-xs">ตรวจแล้ว</span></td>
              <td class="p-3 text-center">
                <button onclick="viewSavedImage(${idx})" class="bg-indigo-100 hover:bg-indigo-200 text-indigo-700 px-3 py-1.5 rounded-lg text-xs font-bold transition mr-1">🖼️ ดูภาพ</button>
                <button onclick="printSavedRecord(${idx})" class="bg-sky-600 hover:bg-sky-700 text-white px-3 py-1.5 rounded-lg text-xs shadow transition">🖨️ PDF</button>
              </td>
            </tr>
          `;
        });
      }

      const schools = {};
      processedRecords.forEach(r => {
        if(!schools[r.school]) schools[r.school] = { count:0, bad:0, fill:0, seal:0 };
        schools[r.school].count += 1;
        schools[r.school].bad += r.totalBad;
        schools[r.school].fill += r.fillingNum;
        schools[r.school].seal += r.sealantNum;
      });

      const tSchool = document.getElementById('school_summary_table');
      tSchool.innerHTML = '';
      if(Object.keys(schools).length === 0) {
        tSchool.innerHTML = '<tr><td colspan="5" class="p-4 text-center text-slate-400">ยังไม่มีข้อมูลการตรวจ</td></tr>';
      } else {
        for(let s in schools) {
          tSchool.innerHTML += `
            <tr class="border-b border-slate-200 hover:bg-sky-50">
              <td class="p-3 font-semibold text-sky-800">${s}</td>
              <td class="p-3 text-center">${schools[s].count} คน</td>
              <td class="p-3 text-center text-rose-600">${schools[s].bad} ซี่</td>
              <td class="p-3 text-center">${schools[s].fill} ซี่</td>
              <td class="p-3 text-center">${schools[s].seal} ซี่</td>
            </tr>
          `;
        }
      }
    }

    function printSavedRecord(idx) {
      const rec = processedRecords[idx];
      
      const fullName = (rec.title || rec.name) ? `${rec.title} ${rec.name}` : '-';
      let thaiDate = '-';
      if(rec.date) {
        const d = new Date(rec.date);
        const m = ['มกราคม','กุมภาพันธ์','มีนาคม','เมษายน','พฤษภาคม','มิถุนายน','กรกฎาคม','สิงหาคม','กันยายน','ตุลาคม','พฤศจิกายน','ธันวาคม'];
        thaiDate = `${d.getDate()} ${m[d.getMonth()]} ${d.getFullYear() + 543}`;
      }

      document.querySelectorAll('.sync-name').forEach(el => el.innerText = fullName);
      document.querySelectorAll('.sync-age').forEach(el => el.innerText = rec.age || '-');
      document.querySelectorAll('.sync-grade').forEach(el => el.innerText = rec.grade || '-');
      document.querySelectorAll('.sync-school').forEach(el => el.innerText = rec.school || '-');
      document.querySelectorAll('.sync-date').forEach(el => el.innerText = thaiDate);
      
      document.getElementById('report_scan_composite').src = rec.compositeImg;
      document.getElementById('report_gum').innerText = rec.gum || '-';
      document.getElementById('report_advice_text').innerText = rec.advice || '-';
      document.getElementById('report_dentist_name').innerText = rec.dentist || '-';

      const tArr = [];
      if(rec.chk_plaque) tArr.push('เน้นแปรงฟันกำจัดคราบจุลินทรีย์');
      if(rec.chk_fluoride) tArr.push('ทาฟลูออไรด์วานิช');
      if(rec.chk_scaling) tArr.push('ขูดหินปูน');
      if(rec.chk_filling) { let n = rec.num_filling; tArr.push(`อุดฟัน ${n?'('+n+' ซี่)':''}`); }
      if(rec.chk_sealant) { let n = rec.num_sealant; tArr.push(`เคลือบหลุมร่องฟัน ${n?'('+n+' ซี่)':''}`); }
      if(rec.chk_ext) { let n = rec.num_ext; tArr.push(`ถอนฟัน ${n?'('+n+' ซี่)':''}`); }
      if(rec.treatment_extra) tArr.push(rec.treatment_extra);
      document.getElementById('report_treatment').innerText = tArr.length > 0 ? tArr.join(', ') : '-';

      document.getElementById('report_arch_upper_box').innerHTML = '<svg id="svg_report_upper" viewBox="0 0 340 250" class="w-full max-w-[340px] mx-auto"></svg>';
      document.getElementById('report_arch_lower_box').innerHTML = '<svg id="svg_report_lower" viewBox="0 0 340 250" class="w-full max-w-[340px] mx-auto"></svg>';
      renderSavedArch('svg_report_upper', upperPermArch, upperPrimaryArch, rec.savedTeethState, 'upper');
      renderSavedArch('svg_report_lower', lowerPermArch, lowerPrimaryArch, rec.savedTeethState, 'lower');

      let pm=0, pr=0; const cnt={risk:0,initial:0,cavity:0,extracted:0,other:0};
      [...upperPermArch, ...lowerPermArch].forEach(t => { const s=rec.savedTeethState[t.id]; if(s!=='unerupted'&&s!=='extracted') pm++; if(cnt[s]!==undefined) cnt[s]++; });
      [...upperPrimaryArch, ...lowerPrimaryArch].forEach(t => { const s=rec.savedTeethState[t.id]; if(s!=='unerupted'&&s!=='extracted') pr++; if(cnt[s]!==undefined) cnt[s]++; });
      document.getElementById('report_stat_counts').innerHTML = `
        <div>• จำนวนฟันทั้งหมดในช่องปาก: <strong class="text-sky-900">${pm+pr} ซี่</strong> (ฟันแท้ ${pm}, ฟันน้ำนม ${pr})</div>
        <div>• ฟันที่มีความเสี่ยงผุ: <strong class="text-yellow-700">${cnt.risk} ซี่</strong></div>
        <div>• ฟันผุระยะเริ่มต้น: <strong class="text-orange-700">${cnt.initial} ซี่</strong></div>
        <div>• ฟันที่ผุเป็นรู: <strong class="text-rose-700">${cnt.cavity} ซี่</strong></div>
        <div>• ฟันที่ถูกถอน: <strong>${cnt.extracted} ซี่</strong></div>
        <div>• ฟันผิดปกติอื่นๆ: <strong>${cnt.other} ซี่</strong></div>
      `;

      const findingsList = document.getElementById('report_findings_list');
      findingsList.innerHTML = '';
      rec.findings.forEach((f, idx) => {
        const item = document.createElement('div');
        item.className = 'border rounded-xl p-2 bg-slate-50 flex flex-col justify-between shadow-sm';
        item.innerHTML = `
          ${f.imgSrc ? `<img src="${f.imgSrc}" class="h-32 w-full object-contain rounded-lg border border-slate-200 mb-1.5 bg-white">` : '<div class="h-32 w-full bg-slate-200 rounded-lg flex items-center justify-center text-[10px] text-slate-400 mb-1.5">ไม่มีภาพแนบ</div>'}
          <div class="text-xs text-slate-700"><strong>จุดที่ ${idx + 1}:</strong> ${f.desc || '-'}</div>
        `;
        findingsList.appendChild(item);
      });

      const p = document.getElementById('print_area');
      p.classList.remove('hidden');
      setTimeout(() => { window.print(); p.classList.add('hidden'); }, 300);
    }

    function syncToReport() {
      const title = document.getElementById('input_title').value;
      const name = document.getElementById('input_name').value.trim();
      const fullName = (title || name) ? `${title} ${name}` : '-';
      const age = document.getElementById('input_age').value || '-';
      const grade = document.getElementById('input_grade').value || '-';
      const school = document.getElementById('input_school').value || '-';
      const dVal = document.getElementById('input_date').value;
      let thaiDate = '-';
      if(dVal) {
        const d = new Date(dVal);
        const m = ['มกราคม','กุมภาพันธ์','มีนาคม','เมษายน','พฤษภาคม','มิถุนายน','กรกฎาคม','สิงหาคม','กันยายน','ตุลาคม','พฤศจิกายน','ธันวาคม'];
        thaiDate = `${d.getDate()} ${m[d.getMonth()]} ${d.getFullYear() + 543}`;
      }

      document.querySelectorAll('.sync-name').forEach(el => el.innerText = fullName);
      document.querySelectorAll('.sync-age').forEach(el => el.innerText = age);
      document.querySelectorAll('.sync-grade').forEach(el => el.innerText = grade);
      document.querySelectorAll('.sync-school').forEach(el => el.innerText = school);
      document.querySelectorAll('.sync-date').forEach(el => el.innerText = thaiDate);
      
      document.getElementById('report_scan_composite').src = document.getElementById('preview_composite').src;
      document.getElementById('report_gum').innerText = document.getElementById('input_gum').value || '-';
      document.getElementById('report_advice_text').innerText = document.getElementById('input_advice').value || '-';
      document.getElementById('report_dentist_name').innerText = document.getElementById('input_dentist').value || '-';

      const tArr = [];
      if(document.getElementById('chk_plaque').checked) tArr.push('เน้นแปรงฟันกำจัดคราบจุลินทรีย์');
      if(document.getElementById('chk_fluoride').checked) tArr.push('ทาฟลูออไรด์วานิช');
      if(document.getElementById('chk_scaling').checked) tArr.push('ขูดหินปูน');
      if(document.getElementById('chk_filling').checked) { let n = document.getElementById('num_filling').value; tArr.push(`อุดฟัน ${n?'('+n+' ซี่)':''}`); }
      if(document.getElementById('chk_sealant').checked) { let n = document.getElementById('num_sealant').value; tArr.push(`เคลือบหลุมร่องฟัน ${n?'('+n+' ซี่)':''}`); }
      if(document.getElementById('chk_ext').checked) { let n = document.getElementById('num_ext').value; tArr.push(`ถอนฟัน ${n?'('+n+' ซี่)':''}`); }
      
      const extra = document.getElementById('input_treatment_extra').value.trim();
      if(extra) tArr.push(extra);
      document.getElementById('report_treatment').innerText = tArr.length > 0 ? tArr.join(', ') : '-';

      document.getElementById('report_arch_upper_box').innerHTML = '<svg id="svg_report_upper" viewBox="0 0 340 250" class="w-full max-w-[340px] mx-auto"></svg>';
      document.getElementById('report_arch_lower_box').innerHTML = '<svg id="svg_report_lower" viewBox="0 0 340 250" class="w-full max-w-[340px] mx-auto"></svg>';
      renderSavedArch('svg_report_upper', upperPermArch, upperPrimaryArch, teethState, 'upper');
      renderSavedArch('svg_report_lower', lowerPermArch, lowerPrimaryArch, teethState, 'lower');

      let pm=0, pr=0; const cnt={risk:0,initial:0,cavity:0,extracted:0,other:0};
      [...upperPermArch, ...lowerPermArch].forEach(t => { const s=teethState[t.id]; if(s!=='unerupted'&&s!=='extracted') pm++; if(cnt[s]!==undefined) cnt[s]++; });
      [...upperPrimaryArch, ...lowerPrimaryArch].forEach(t => { const s=teethState[t.id]; if(s!=='unerupted'&&s!=='extracted') pr++; if(cnt[s]!==undefined) cnt[s]++; });
      document.getElementById('report_stat_counts').innerHTML = `
        <div>• จำนวนฟันทั้งหมดในช่องปาก: <strong class="text-sky-900">${pm+pr} ซี่</strong> (ฟันแท้ ${pm}, ฟันน้ำนม ${pr})</div>
        <div>• ฟันที่มีความเสี่ยงผุ: <strong class="text-yellow-700">${cnt.risk} ซี่</strong></div>
        <div>• ฟันผุระยะเริ่มต้น: <strong class="text-orange-700">${cnt.initial} ซี่</strong></div>
        <div>• ฟันที่ผุเป็นรู: <strong class="text-rose-700">${cnt.cavity} ซี่</strong></div>
        <div>• ฟันที่ถูกถอน: <strong>${cnt.extracted} ซี่</strong></div>
        <div>• ฟันผิดปกติอื่นๆ: <strong>${cnt.other} ซี่</strong></div>
      `;

      const findingsList = document.getElementById('report_findings_list');
      findingsList.innerHTML = '';
      document.querySelectorAll('.finding-row').forEach((row, idx) => {
        const desc = row.querySelector('.finding-desc').value;
        let imgSrc = '';
        const imgEl = row.querySelector('.finding-img');
        const fileInput = row.querySelector('.finding-file');
        
        if (imgEl && imgEl.getAttribute('data-base64')) {
            imgSrc = imgEl.getAttribute('data-base64');
        } else if (fileInput && fileInput.getAttribute('data-base64')) {
            imgSrc = fileInput.getAttribute('data-base64');
        }

        const item = document.createElement('div');
        item.className = 'border rounded-xl p-2 bg-slate-50 flex flex-col justify-between shadow-sm';
        item.innerHTML = `
          ${imgSrc ? `<img src="${imgSrc}" class="h-32 w-full object-contain rounded-lg border border-slate-200 mb-1.5 bg-white">` : '<div class="h-32 w-full bg-slate-200 rounded-lg flex items-center justify-center text-[10px] text-slate-400 mb-1.5">ไม่มีภาพแนบ</div>'}
          <div class="text-xs text-slate-700"><strong>จุดที่ ${idx + 1}:</strong> ${desc || '-'}</div>
        `;
        findingsList.appendChild(item);
      });
    }

    function printReport() {
      syncToReport();
      const p = document.getElementById('print_area');
      p.classList.remove('hidden');
      setTimeout(() => { window.print(); p.classList.add('hidden'); }, 300);
    }

    window.onload = () => {
      document.getElementById('input_date').value = new Date().toISOString().split('T')[0];
      initArchOdontogram();
    };
  </script>
</body>
