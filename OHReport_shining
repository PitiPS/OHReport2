      guideInner.setAttribute('d', type === 'upper' ? 'M 92 125 C 105 50, 235 50, 248 125' : 'M 92 125 C 105 200, 235 200, 248 125');
      guideInner.setAttribute('fill', 'none'); guideInner.setAttribute('stroke', '#f1f5f9'); guideInner.setAttribute('stroke-dasharray', '2,2');
      svg.appendChild(guideInner);

      permList.forEach(t => drawSavedTooth(svg, t, stateToRender[t.id], false));
      primaryList.forEach(t => drawSavedTooth(svg, t, stateToRender[t.id], true));
    }

    function drawSavedTooth(svg, tooth, statusId, isPrimary) {
      const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
      g.setAttribute('transform', `translate(${tooth.x}, ${tooth.y}) rotate(${tooth.r})`);
      const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      path.setAttribute('d', isPrimary ? 'M -5.5 -8 C -7.5 -4, -6.5 5, -5 8 C -2 9.5, 2 9.5, 5 8 C 6.5 5, 7.5 -4, 5.5 -8 C 3 -9.5, -3 -9.5, -5.5 -8 Z' : 'M -7 -10 C -9 -5, -8 6, -6 10 C -2 12, 2 12, 6 10 C 8 6, 9 -5, 7 -10 C 4 -12, -4 -12, -7 -10 Z');
      path.setAttribute('stroke-width', isPrimary ? '1.2' : '1.5');
      const cls = statuses.find(s=>s.id===statusId)?.cls || 'tooth-normal';
      path.setAttribute('class', `tooth-path ${cls}`);
      
      const text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
      text.setAttribute('text-anchor', 'middle'); text.setAttribute('dominant-baseline', 'central'); text.setAttribute('font-size', isPrimary ? '6' : '6.5'); text.setAttribute('font-weight', 'bold');
      text.setAttribute('fill', statusId === 'unerupted' ? '#ffffff' : '#334155'); text.setAttribute('transform', `rotate(-${tooth.r})`); text.textContent = tooth.id;
      g.appendChild(path); g.appendChild(text);
      svg.appendChild(g);
    }

    function renderDualArch(svgId, permList, primaryList, isInteractive, type) {
      const svg = document.getElementById(svgId);
      svg.innerHTML = '';
      const guideOuter = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      guideOuter.setAttribute('d', type === 'upper' ? 'M 26 215 C 35 30, 305 30, 314 215' : 'M 26 35 C 35 220, 305 220, 314 35');
      guideOuter.setAttribute('fill', 'none'); guideOuter.setAttribute('stroke', '#e2e8f0');
      svg.appendChild(guideOuter);
      const guideInner = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      guideInner.setAttribute('d', type === 'upper' ? 'M 92 125 C 105 50, 235 50, 248 125' : 'M 92 125 C 105 200, 235 200, 248 125');
      guideInner.setAttribute('fill', 'none'); guideInner.setAttribute('stroke', '#f1f5f9'); guideInner.setAttribute('stroke-dasharray', '2,2');
      svg.appendChild(guideInner);

      permList.forEach(t => drawTooth(svg, t, isInteractive, false));
      primaryList.forEach(t => drawTooth(svg, t, isInteractive, true));
    }

    function drawTooth(svg, tooth, isInteractive, isPrimary) {
      const g = document.createElementNS('http://www.w3.org/2000/svg', 'g');
      g.setAttribute('transform', `translate(${tooth.x}, ${tooth.y}) rotate(${tooth.r})`);
      const path = document.createElementNS('http://www.w3.org/2000/svg', 'path');
      path.setAttribute('d', isPrimary ? 'M -5.5 -8 C -7.5 -4, -6.5 5, -5 8 C -2 9.5, 2 9.5, 5 8 C 6.5 5, 7.5 -4, 5.5 -8 C 3 -9.5, -3 -9.5, -5.5 -8 Z' : 'M -7 -10 C -9 -5, -8 6, -6 10 C -2 12, 2 12, 6 10 C 8 6, 9 -5, 7 -10 C 4 -12, -4 -12, -7 -10 Z');
      path.setAttribute('stroke-width', isPrimary ? '1.2' : '1.5');
      path.setAttribute('class', `tooth-path ${statuses.find(s=>s.id===teethState[tooth.id])?.cls || 'tooth-normal'}`);
      path.setAttribute('id', `tooth_${isInteractive ? 'ui' : 'rep'}_${tooth.id}`);
      
      const text = document.createElementNS('http://www.w3.org/2000/svg', 'text');
      text.setAttribute('text-anchor', 'middle'); text.setAttribute('dominant-baseline', 'central'); text.setAttribute('font-size', isPrimary ? '6' : '6.5'); text.setAttribute('font-weight', 'bold');
      text.setAttribute('fill', teethState[tooth.id] === 'unerupted' ? '#ffffff' : '#334155'); text.setAttribute('transform', `rotate(-${tooth.r})`); text.textContent = tooth.id;
      g.appendChild(path); g.appendChild(text);
      if (isInteractive) g.onclick = () => {
        const curIdx = statuses.findIndex(s => s.id === teethState[tooth.id]);
        const nextIdx = (curIdx + 1) % statuses.length;
        updateToothUI(tooth.id, statuses[nextIdx].id);
      };
      svg.appendChild(g);
    }

    function updateToothUI(toothId, statusId) {
      teethState[toothId] = statusId;
      const el = document.getElementById(`tooth_ui_${toothId}`);
      if (el) {
        el.setAttribute('class', `tooth-path ${statuses.find(s=>s.id===statusId).cls}`);
        if(el.nextElementSibling) el.nextElementSibling.setAttribute('fill', statusId === 'unerupted' ? '#ffffff' : '#334155');
      }
    }

