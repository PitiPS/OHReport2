      const imgFolder = zip.folder("Images"); // สร้างโฟลเดอร์สำหรับเก็บภาพสแกน

      const studentData = processedRecords.map((r, index) => {
        let fileName = "ไม่มีภาพ.png";
        
        // ถ้ามีภาพ นำ Base64 มาแปลงและใส่ลง ZIP
        if (r.compositeImg && r.compositeImg.startsWith('data:image')) {
          const ext = r.compositeImg.substring("data:image/".length, r.compositeImg.indexOf(";base64"));
          const base64Data = r.compositeImg.split(',')[1];
          fileName = `IMG_${index + 1}_${r.name.replace(/\s+/g, '_')}.${ext}`;
          imgFolder.file(fileName, base64Data, {base64: true});
        }

        return {
          "ลำดับ": index + 1,
          "ชื่อ-สกุล": r.name,
          "ระดับชั้น": r.grade,
          "โรงเรียน": r.school,
          "พบความเสี่ยง/ผุ (ซี่)": r.totalBad,
          "ต้องอุดฟัน (ซี่)": r.fillingNum,
          "ต้องเคลือบหลุมร่องฟัน (ซี่)": r.sealantNum,
          "ไฟล์ภาพอ้างอิง": fileName // ระบุชื่อไฟล์ในคอลัมน์ Excel ให้ลิงก์กัน
        };
      });

      const schools = {};
      processedRecords.forEach(r => {
        if(!schools[r.school]) schools[r.school] = { count:0, bad:0, fill:0, seal:0 };
        schools[r.school].count += 1; schools[r.school].bad += r.totalBad; schools[r.school].fill += r.fillingNum; schools[r.school].seal += r.sealantNum;
      });
      const schoolData = Object.keys(schools).map((s, index) => ({
        "ลำดับ": index + 1, "โรงเรียน": s, "จำนวนเด็กที่ตรวจแล้ว": schools[s].count,
        "พบความเสี่ยง/ผุ (ซี่)": schools[s].bad, "ต้องอุดฟัน (ซี่)": schools[s].fill, "ต้องเคลือบหลุมร่องฟัน (ซี่)": schools[s].seal
      }));

      // สร้าง Excel File
      const wsStudents = XLSX.utils.json_to_sheet(studentData);
      const wsSchools = XLSX.utils.json_to_sheet(schoolData);
      const wb = XLSX.utils.book_new();
      XLSX.utils.book_append_sheet(wb, wsSchools, "สรุปรายโรงเรียน");
      XLSX.utils.book_append_sheet(wb, wsStudents, "ข้อมูลรายบุคคล");

      // ใส่ Excel ลงไปใน Zip
      const excelBuffer = XLSX.write(wb, { bookType: 'xlsx', type: 'array' });
      zip.file("รายงานสรุปสภาวะฟัน_พร้อมรูปภาพอ้างอิง.xlsx", excelBuffer);

      // โหลด Zip ให้ผู้ใช้
      const content = await zip.generateAsync({ type: "blob" });
      const url = URL.createObjectURL(content);
      const a = document.createElement("a");
      a.href = url;
      a.download = "Dental_Dashboard_Export.zip";
      a.click();
      URL.revokeObjectURL(url);
    }

