        try {
          const zip = await JSZip.loadAsync(file);
          let foundComposite = false;
          
          for (const [filename, fileData] of Object.entries(zip.files)) {
            if (fileData.dir) continue;
            const lower = filename.toLowerCase();
            if (lower.includes('snapshot') && (lower.endsWith('.png') || lower.endsWith('.jpg') || lower.endsWith('.jpeg'))) {
              const blob = await fileData.async('blob');
              const dataUrl = await blobToDataURL(blob);

              if (lower.includes('quadrant_composite')) {
                document.getElementById('preview_composite').src = dataUrl;
                foundComposite = true;
              } else if (lower.includes('front') || lower.includes('center')) {
                scannedImages['front'] = dataUrl;
              } else if (lower.includes('left')) {
                scannedImages['left'] = dataUrl;
              } else if (lower.includes('right')) {
                scannedImages['right'] = dataUrl;
              } else if (lower.includes('upper') || lower.includes('maxillary')) {
                scannedImages['upper'] = dataUrl;
              } else if (lower.includes('lower') || lower.includes('mandibular')) {
                scannedImages['lower'] = dataUrl;
              }
            }
          }
          if(!foundComposite) { statusBox.classList.add('hidden'); alert('ไม่พบไฟล์ quadrant_composite ใน zip'); return; }
          renderSnapshotThumbnails();
