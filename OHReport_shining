<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ระบบบันทึกผลตรวจสุขภาพช่องปาก (3D Scan & Dashboard)</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <!-- JSZip สำหรับแตกไฟล์ .zip -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/jszip/3.10.1/jszip.min.js"></script>
  <!-- SheetJS สำหรับอ่าน/เขียน Excel -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/xlsx/0.18.5/xlsx.full.min.js"></script>
  <link href="https://fonts.googleapis.com/css2?family=Sarabun:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">
  <style>
    * { font-family: 'Sarabun', sans-serif; }
    * { -webkit-print-color-adjust: exact !important; print-color-adjust: exact !important; color-adjust: exact !important; }
    .tooth-path { transition: fill 0.15s ease, stroke 0.15s ease; cursor: pointer; }
    
    .bg-status-normal { background-color: #ffffff; border-color: #94a3b8; color: #1e293b; }
    .bg-status-risk { background-color: #fef08a; border-color: #ca8a04; color: #854d0e; }
    .bg-status-initial { background-color: #fed7aa; border-color: #ea580c; color: #9a3412; }
    .bg-status-cavity { background-color: #fca5a5; border-color: #dc2626; color: #991b1b; }
    .bg-status-extracted { background-color: #e2e8f0; border-color: #94a3b8; color: #64748b; }
    .bg-status-unerupted { background-color: #64748b; border-color: #334155; color: #ffffff; }
    .bg-status-other { background-color: #e9d5ff; border-color: #9333ea; color: #6b21a8; }

    .tooth-normal { fill: #ffffff !important; stroke: #94a3b8 !important; }
    .tooth-risk { fill: #fef08a !important; stroke: #ca8a04 !important; }
    .tooth-initial { fill: #fed7aa !important; stroke: #ea580c !important; }
    .tooth-cavity { fill: #fca5a5 !important; stroke: #dc2626 !important; }
    .tooth-extracted { fill: #e2e8f0 !important; stroke: #94a3b8 !important; }
    .tooth-unerupted { fill: #64748b !important; stroke: #334155 !important; }
    .tooth-other { fill: #e9d5ff !important; stroke: #9333ea !important; }

    @media print {
      body { background-color: white !important; padding: 0 !important; margin: 0 !important; }
      .no-print { display: none !important; }
      .print-container { display: block !important; width: 100% !important; }
      .page { width: 210mm; min-height: 297mm; padding: 12mm; margin: 0 auto; page-break-after: always; box-sizing: border-box; background: white !important; }
      @page { size: A4 portrait; margin: 0; }
    }
    
    .tab-btn.active { border-bottom: 4px solid #0284c7; color: #0369a1; font-weight: bold; }
    .tab-content { display: none; }
    .tab-content.active { display: block; }
  </style>
</head>
<body class="bg-slate-100 text-slate-800 h-screen flex flex-col relative">

  <!-- ================= Navigation Tabs ================= -->
  <div class="bg-white shadow-sm border-b px-4 md:px-8 pt-4 flex gap-6 no-print shrink-0">
    <button onclick="switchTab('tab-dashboard')" id="btn-tab-dashboard" class="tab-btn active pb-3 text-slate-500 hover:text-sky-700 transition">📊 แดชบอร์ด & ฐานข้อมูลนักเรียน</button>
    <button onclick="switchTab('tab-exam')" id="btn-tab-exam" class="tab-btn pb-3 text-slate-500 hover:text-sky-700 transition">🦷 ตรวจและออกรายงาน (สแกน 3D)</button>
  </div>

  <div class="overflow-y-auto flex-1 p-4 md:p-6 no-print">
    
    <!-- ================= TAB 1: แดชบอร์ด & นำเข้า Excel ================= -->
    <div id="tab-dashboard" class="tab-content active max-w-6xl mx-auto space-y-6">
      
      <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
        <div class="flex flex-col md:flex-row md:items-center justify-between gap-4 mb-4">
          <h2 class="text-xl font-bold text-sky-800 flex items-center gap-2"><span>📂</span> จัดการฐานข้อมูลนักเรียน (Excel)</h2>
          
          <!-- อัปเดตปุ่มเป็นระบบ Export ZIP แพ็คไฟล์รูป -->
          <button onclick="exportDashboardZip()" class="bg-indigo-600 hover:bg-indigo-700 text-white font-bold py-2.5 px-5 rounded-xl shadow transition text-sm flex items-center gap-2">
            📥 ดาวน์โหลดสรุปข้อมูล + ภาพสแกน (.ZIP)
          </button>
        </div>
        
        <div class="flex flex-wrap gap-4 items-center bg-slate-50 p-4 rounded-xl border border-slate-200">
          <button onclick="downloadExcelTemplate()" class="bg-emerald-600 hover:bg-emerald-700 text-white font-bold py-2 px-4 rounded-lg shadow transition text-sm flex items-center gap-2">
            📝 โหลดไฟล์ Template นำเข้า
          </button>
          <div class="h-8 w-px bg-slate-300"></div>
          <label class="bg-sky-600 hover:bg-sky-700 text-white font-bold py-2 px-4 rounded-lg shadow cursor-pointer transition text-sm flex items-center gap-2">
            <span>📤</span> อัปโหลดรายชื่อจาก Excel
            <input type="file" accept=".xlsx, .xls" onchange="handleExcelImport(event)" class="hidden">
          </label>
          <span id="import_status" class="text-xs font-semibold text-emerald-700 hidden">✓ โหลดข้อมูลสำเร็จ <span id="student_count">0</span> คน</span>
        </div>
      </div>

      <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
        <h2 class="text-xl font-bold text-sky-800 mb-4">📊 สรุปข้อมูลสภาวะฟันแยกตามโรงเรียน</h2>
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-sky-100 text-sky-900 border-b-2 border-sky-200">
                <th class="p-3 font-bold">โรงเรียน</th>
                <th class="p-3 font-bold text-center">จำนวนเด็กที่ตรวจแล้ว</th>
                <th class="p-3 font-bold text-center">พบความเสี่ยง/ผุ</th>
                <th class="p-3 font-bold text-center">ต้องอุดฟัน</th>
                <th class="p-3 font-bold text-center">ต้องเคลือบหลุมร่องฟัน</th>
              </tr>
            </thead>
            <tbody id="school_summary_table">
              <tr><td colspan="5" class="p-4 text-center text-slate-400">ยังไม่มีข้อมูลการตรวจ (กรุณาตรวจในแท็บถัดไปแล้วกดบันทึก)</td></tr>
            </tbody>
          </table>
        </div>
      </div>

      <div class="bg-white p-6 rounded-2xl shadow-sm border border-slate-200">
        <h2 class="text-xl font-bold text-sky-800 mb-4">📋 รายชื่อนักเรียนและผลตรวจเบื้องต้น</h2>
        <div class="overflow-x-auto">
          <table class="w-full text-left border-collapse text-sm">
            <thead>
              <tr class="bg-slate-100 border-b border-slate-300">
                <th class="p-3 font-bold">ชื่อ-สกุล</th>
                <th class="p-3 font-bold">ชั้น</th>
                <th class="p-3 font-bold">โรงเรียน</th>
                <th class="p-3 font-bold text-center">ฟันผุ/เสี่ยง</th>
                <th class="p-3 font-bold text-center">สถานะ</th>
                <th class="p-3 font-bold text-center">การจัดการ</th>
              </tr>
            </thead>
            <tbody id="student_records_table">
              <tr><td colspan="6" class="p-4 text-center text-slate-400">ยังไม่มีบันทึกข้อมูล</td></tr>
            </tbody>
          </table>
        </div>
      </div>
    </div>

    <!-- ================= TAB 2: ตรวจและออกรายงาน ================= -->
    <div id="tab-exam" class="tab-content max-w-4xl mx-auto space-y-6">
      
      <!-- การนำเข้าไฟล์และจับคู่รายชื่อ (Cloud & Zip) -->
      <div class="bg-gradient-to-r from-sky-800 to-indigo-900 text-white p-6 rounded-2xl shadow-md space-y-4">
        <div>
          <span class="inline-block bg-emerald-500/30 text-emerald-200 text-xs px-2.5 py-1 rounded-full font-bold mb-2">⚡ ระบบจับคู่และวิเคราะห์ AI วินิจฉัยทุกสภาวะ</span>
          <h2 class="text-xl font-bold">นำเข้าภาพสแกน 3D ช่องปาก</h2>
        </div>
        
        <div class="flex flex-wrap items-center gap-3">
          <div class="flex-1 min-w-[250px]">
            <label class="text-xs text-sky-200 block mb-1">เลือกชื่อนักเรียนจากฐานข้อมูล:</label>
            <select id="db_student_select" onchange="loadStudentToForm()" class="w-full border-0 rounded-lg p-2.5 text-sm bg-white text-slate-800 font-semibold shadow-inner">
              <option value="">-- กรุณานำเข้าไฟล์ Excel ก่อน --</option>
            </select>
          </div>
          <div class="text-sky-300 font-bold hidden md:block">|</div>
          <div class="flex gap-2 mt-4 md:mt-0 items-end">
            <label class="bg-amber-400 hover:bg-amber-300 text-slate-900 font-bold px-4 py-2.5 rounded-xl shadow cursor-pointer transition flex items-center gap-2 text-sm">
              <span>📦</span> อัปโหลด .ZIP สแกนเนอร์
              <input type="file" id="zip_file_input" accept=".zip" onchange="handleZipUpload(event)" class="hidden">
            </label>
            <button type="button" onclick="simulateCloudSync()" class="bg-indigo-600 hover:bg-indigo-500 text-white font-bold px-4 py-2.5 rounded-xl shadow transition flex items-center gap-2 text-sm border border-indigo-400">
              <span>☁️</span> ดึงจาก Alliedstar Cloud
            </button>
          </div>
        </div>
        <div id="ai_status_box" class="hidden pt-3 border-t border-sky-700/60 text-xs flex items-center gap-2 text-amber-200">
          <svg class="animate-spin h-4 w-4 text-amber-300" viewBox="0 0 24 24" fill="none">
            <circle class="opacity-25" cx="12" cy="12" r="10" stroke="currentColor" stroke-width="4"></circle>
            <path class="opacity-75" fill="currentColor" d="M4 12a8 8 0 018-8v8H4z"></path>
          </svg>
          <span id="ai_status_text">กำลังประมวลผล...</span>
        </div>
      </div>

      <!-- ฟอร์มข้อมูลหลัก -->
      <div class="bg-white p-6 md:p-8 rounded-2xl shadow-sm border border-slate-200">
        <div class="flex items-center justify-between border-b pb-4 mb-6">
          <div>
            <h1 class="text-2xl font-bold text-sky-800">🦷 ข้อมูลการตรวจสุขภาพช่องปาก</h1>
            <p class="text-xs text-slate-500">สำนักทันตสาธารณสุข กรมอนามัย กระทรวงสาธารณสุข</p>
          </div>
        </div>

        <!-- 1. ข้อมูลนักเรียน -->
        <h2 class="text-sm font-bold text-slate-700 mb-3 flex items-center gap-2">
          <span class="w-2 h-4 bg-sky-600 rounded-full inline-block"></span> 1. ข้อมูลนักเรียนและสถานศึกษา
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-6 gap-3 mb-6">
          <div>
            <label class="text-xs font-semibold text-slate-600 block mb-1">คำนำหน้า</label>
            <select id="input_title" class="w-full border rounded-lg p-2 text-sm bg-slate-50">
              <option value="" selected>-- เลือก --</option>
              <option value="เด็กหญิง">เด็กหญิง</option>
              <option value="เด็กชาย">เด็กชาย</option>
            </select>
          </div>
          <div class="md:col-span-3">
            <label class="text-xs font-semibold text-slate-600 block mb-1">ชื่อ - สกุล นักเรียน</label>
            <input type="text" id="input_name" placeholder="ระบุชื่อ-สกุล" class="w-full border rounded-lg p-2 text-sm bg-slate-50">
          </div>
          <div>
            <label class="text-xs font-semibold text-slate-600 block mb-1">อายุ (ปี)</label>
            <input type="number" id="input_age" placeholder="ระบุอายุ" class="w-full border rounded-lg p-2 text-sm bg-slate-50">
          </div>
          <div>
            <label class="text-xs font-semibold text-slate-600 block mb-1">ระดับชั้น</label>
            <input type="text" id="input_grade" placeholder="เช่น ป.6" class="w-full border rounded-lg p-2 text-sm bg-slate-50">
          </div>
          <div class="md:col-span-4">
            <label class="text-xs font-semibold text-slate-600 block mb-1">โรงเรียน / สถานศึกษา</label>
            <input list="school_list" id="input_school" placeholder="ระบุชื่อโรงเรียน หรือกดเลือก..." class="w-full border rounded-lg p-2 text-sm bg-slate-50">
            <datalist id="school_list">
              <option value="โรงเรียนตำรวจตระเวนชายแดนสิงคโปร์แอร์ไลน์ฯ จังหวัดจันทบุรี">
              <option value="โรงเรียนตำรวจตระเวนชายแดนปากห้วยม่วง จังหวัดนครพนม">
            </datalist>
          </div>
          <div class="md:col-span-2">
            <label class="text-xs font-semibold text-slate-600 block mb-1">วันที่ตรวจ</label>
            <input type="date" id="input_date" class="w-full border rounded-lg p-2 text-sm bg-slate-50">
          </div>
        </div>

        <!-- 2. ภาพถ่ายช่องปาก -->
        <h2 class="text-sm font-bold text-slate-700 mb-2 flex items-center gap-2">
          <span class="w-2 h-4 bg-sky-600 rounded-full inline-block"></span> 2. ภาพถ่ายช่องปาก (Quadrant Composite)
        </h2>
        <div class="bg-slate-50 p-4 rounded-xl border border-slate-200 mb-6 text-center">
          <img id="preview_composite" src="data:image/svg+xml;utf8,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 400 200'><rect width='400' height='200' fill='%23f1f5f9'/><text x='200' y='100' font-family='sans-serif' font-size='14' fill='%2394a3b8' text-anchor='middle'>อัปโหลดไฟล์ ZIP หรือกดดึงข้อมูลเพื่อแสดงภาพ</text></svg>" class="w-full max-w-xl mx-auto h-auto min-h-[150px] object-contain bg-white rounded-xl border border-slate-300 shadow-sm" alt="ภาพสแกน">
        </div>

        <!-- 3. ผังฟัน Odontogram -->
        <div class="mb-6">
          <h2 class="text-sm font-bold text-slate-700 mb-2 flex items-center gap-2">
            <span class="w-2 h-4 bg-sky-600 rounded-full inline-block"></span> 3. ระบุสภาวะฟันบนผัง Arch (วงนอก: ฟันแท้ | วงใน: ฟันน้ำนม)
          </h2>
          <div class="grid grid-cols-2 md:grid-cols-4 gap-2 text-xs mb-3 p-3 bg-slate-50 rounded-xl border border-slate-200">
            <div class="flex items-center gap-2"><span class="w-3 h-3 rounded border bg-status-normal inline-block"></span> <span>ปกติ</span></div>
            <div class="flex items-center gap-2"><span class="w-3 h-3 rounded border bg-status-risk inline-block"></span> <span>เสี่ยงผุ</span></div>
            <div class="flex items-center gap-2"><span class="w-3 h-3 rounded border bg-status-initial inline-block"></span> <span>ผุระยะเริ่มต้น</span></div>
            <div class="flex items-center gap-2"><span class="w-3 h-3 rounded border bg-status-cavity inline-block"></span> <span>ผุเป็นรู</span></div>
            <div class="flex items-center gap-2"><span class="w-3 h-3 rounded border bg-status-extracted inline-block text-center line-through text-[8px] leading-3 text-slate-500">X</span> <span>ถูกถอน</span></div>
            <div class="flex items-center gap-2"><span class="w-3 h-3 rounded border bg-status-unerupted inline-block"></span> <span>ยังไม่ขึ้น/หลุดไปแล้ว</span></div>
            <div class="flex items-center gap-2"><span class="w-3 h-3 rounded border bg-status-other inline-block"></span> <span>ผิดปกติอื่นๆ</span></div>
          </div>

          <div class="grid grid-cols-1 md:grid-cols-2 gap-4 bg-slate-50 p-4 rounded-xl border border-slate-200">
            <div class="text-center bg-white p-4 rounded-lg border shadow-2xs">
              <div class="text-xs font-bold text-sky-800 mb-1">ฟันบน (Upper Arch)</div>
              <svg id="svg_arch_upper" viewBox="0 0 340 250" class="w-full max-w-[280px] mx-auto"></svg>
            </div>
            <div class="text-center bg-white p-4 rounded-lg border shadow-2xs">
              <div class="text-xs font-bold text-sky-800 mb-1">ฟันล่าง (Lower Arch)</div>
              <svg id="svg_arch_lower" viewBox="0 0 340 250" class="w-full max-w-[280px] mx-auto"></svg>
            </div>
          </div>
        </div>

        <!-- 4. แผนการรักษา -->
        <h2 class="text-sm font-bold text-slate-700 mb-3 flex items-center gap-2">
          <span class="w-2 h-4 bg-sky-600 rounded-full inline-block"></span> 4. สุขภาพเหงือกและแผนการรักษา
        </h2>
        <div class="grid grid-cols-1 md:grid-cols-2 gap-4 mb-6">
          <div>
            <label class="text-xs font-semibold text-slate-600 block mb-1">สุขภาพเหงือก</label>
            <select id="input_gum" class="w-full border rounded-lg p-2 text-sm bg-white">
              <option value="" selected>-- เลือกสภาวะเหงือก --</option>
              <option value="เหงือกปกติ แข็งแรงดี">เหงือกปกติ แข็งแรงดี</option>
              <option value="เหงือกอักเสบเล็กน้อย">เหงือกอักเสบเล็กน้อย</option>
              <option value="เหงือกอักเสบปานกลาง">เหงือกอักเสบปานกลาง มีเลือดออก</option>
              <option value="เหงือกอักเสบรุนแรง">เหงือกอักเสบรุนแรง</option>
            </select>
          </div>
          <div>
            <label class="text-xs font-semibold text-slate-600 block mb-1">ทันตแพทย์ผู้รายงานผล</label>
            <div class="flex gap-2">
              <select id="dentist_select" onchange="handleDentistSelect(this)" class="w-1/2 border rounded-lg p-2 text-xs bg-white">
                <option value="ทพญ.ภัทราภรณ์ หัสดิเสวี" selected>ทพญ.ภัทราภรณ์ หัสดิเสวี</option>
                <option value="ทพ.เอกชัย สุขภาพดี">ทพ.เอกชัย สุขภาพดี</option>
                <option value="ทพญ.วิไลลักษณ์ ฟันสวย">ทพญ.วิไลลักษณ์ ฟันสวย</option>
                <option value="custom">-- พิมพ์ระบุเอง --</option>
              </select>
              <input type="text" id="input_dentist" value="ทพญ.ภัทราภรณ์ หัสดิเสวี" class="w-1/2 border rounded-lg p-2 text-xs bg-slate-50">
            </div>
          </div>

          <div class="md:col-span-2 bg-slate-50 p-3 rounded-xl border border-slate-200">
            <label class="text-xs font-semibold text-slate-700 block mb-2">แผนการรักษาที่แนะนำ:</label>
            <div class="grid grid-cols-1 md:grid-cols-2 gap-y-3 gap-x-2 text-xs mb-2">
              <label class="flex items-center gap-1.5"><input type="checkbox" id="chk_plaque" class="rounded text-sky-600 w-4 h-4"> เน้นแปรงฟันกำจัดคราบจุลินทรีย์</label>
              <label class="flex items-center gap-1.5"><input type="checkbox" id="chk_fluoride" class="rounded text-sky-600 w-4 h-4"> ทาฟลูออไรด์วานิช</label>
              <label class="flex items-center gap-1.5"><input type="checkbox" id="chk_scaling" class="rounded text-sky-600 w-4 h-4"> ขูดหินปูน</label>
              <label class="flex items-center gap-1.5"><input type="checkbox" id="chk_filling" class="rounded text-sky-600 w-4 h-4"> อุดฟัน <input type="number" id="num_filling" placeholder="ซี่" class="w-12 border rounded px-1 ml-1 text-center bg-white"></label>
              <label class="flex items-center gap-1.5"><input type="checkbox" id="chk_sealant" class="rounded text-sky-600 w-4 h-4"> เคลือบหลุมร่องฟัน <input type="number" id="num_sealant" placeholder="ซี่" class="w-12 border rounded px-1 ml-1 text-center bg-white"></label>
